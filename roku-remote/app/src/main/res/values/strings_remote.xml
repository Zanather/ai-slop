    <string name="remote_blocked_limited_title">Your TV is blocking remote apps</string>
    <string name="remote_blocked_limited_body">Roku TVs ship with phone control set to Limited. One-time fix on the TV:</string>
    <string-array name="remote_blocked_steps">
        <item>Home</item>
        <item>Settings</item>
        <item>System</item>
        <item>Advanced system settings</item>
        <item>Control by mobile apps</item>
        <item>Network access</item>
        <item>Enabled</item>
    </string-array>
    <string name="remote_blocked_steps_description">On the TV, go to Home, Settings, System, Advanced system settings, Control by mobile apps, Network access, and choose Enabled.</string>
    <string name="remote_blocked_enabled_note">Enabled is enough; you don\'t need Permissive.</string>
    <string name="remote_blocked_official_app_note">No remote handy? The official Roku app can still get you there.</string>
    <string name="remote_blocked_refused_title">Your TV refused the connection</string>
    <string name="remote_blocked_refused_body">On the TV, check Control by mobile apps isn\'t Disabled, and that your phone is on the same Wi-Fi as the TV (not a guest network or VPN).</string>
